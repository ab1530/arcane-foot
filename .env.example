# =======================================
# ARCANE PLATFORM - ENVIRONMENT VARIABLES
# =======================================
# Copy this file to .env and fill with your actual values
# NEVER commit .env to version control!

# ===== DATABASE =====
DATABASE_URL="postgresql://arcane_user:arcane_pass@localhost:5432/arcane_db?schema=public"

# ===== JWT AUTHENTICATION =====
JWT_SECRET="CHANGE_ME_TO_A_STRONG_256_BIT_SECRET_KEY_IN_PRODUCTION"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="CHANGE_ME_TO_ANOTHER_STRONG_SECRET_KEY"
JWT_REFRESH_EXPIRES_IN="30d"

# ===== SUPABASE STORAGE =====
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_KEY="your-service-role-key-here"
SUPABASE_STORAGE_BUCKET="arcane-media"

# ===== STRIPE PAYMENTS =====
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
STRIPE_PRICE_ID_BASIC="price_basic_monthly"
STRIPE_PRICE_ID_PRO="price_pro_monthly"
STRIPE_PRICE_ID_ENTERPRISE="price_enterprise_monthly"

# ===== FIREBASE CLOUD MESSAGING =====
FCM_SERVER_KEY="your-fcm-server-key"
FCM_PROJECT_ID="your-firebase-project-id"
FIREBASE_ADMIN_SDK_JSON_PATH="./config/firebase-adminsdk.json"

# ===== OAUTH PROVIDERS =====
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

APPLE_CLIENT_ID="com.arcane.app"
APPLE_TEAM_ID="your-apple-team-id"
APPLE_KEY_ID="your-apple-key-id"
APPLE_PRIVATE_KEY_PATH="./config/apple-private-key.p8"

# ===== REDIS (optional - for caching & queues) =====
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# ===== EMAIL SERVICE (optional - SendGrid, AWS SES, etc.) =====
EMAIL_PROVIDER="sendgrid"
SENDGRID_API_KEY="your-sendgrid-api-key"
EMAIL_FROM="noreply@arcane.com"
EMAIL_FROM_NAME="Arcane Platform"

# ===== SENTRY MONITORING =====
SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
SENTRY_ENVIRONMENT="development"

# ===== API CONFIGURATION =====
API_PORT="3000"
API_HOST="localhost"
API_BASE_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:8080"
ALLOWED_ORIGINS="http://localhost:8080,http://localhost:3000"

# ===== RATE LIMITING =====
RATE_LIMIT_TTL="900"
RATE_LIMIT_MAX="100"

# ===== VIDEO PROCESSING =====
FFMPEG_PATH="/usr/bin/ffmpeg"
VIDEO_TRANSCODE_PRESET="medium"
VIDEO_MAX_SIZE_MB="500"

# ===== ADMIN DASHBOARD (Next.js) =====
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# ===== FLUTTER MOBILE APP =====
FLUTTER_API_BASE_URL="http://localhost:3000"
FLUTTER_SUPABASE_URL="https://your-project.supabase.co"
FLUTTER_SUPABASE_ANON_KEY="your-anon-key"

# ===== BACKUP & MAINTENANCE =====
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS="30"
BACKUP_S3_BUCKET="arcane-backups"

# ===== DEVELOPMENT / TESTING =====
NODE_ENV="development"
LOG_LEVEL="debug"
ENABLE_SWAGGER="true"
ENABLE_CORS="true"
