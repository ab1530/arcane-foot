# MarketValue AI Service Configuration

# Database connection (required for fetching player data and storing predictions)
DATABASE_URL=postgresql://user:password@localhost:5432/database

# Service port (default: 8001)
PORT=8001

# Model configuration
MODEL_VERSION=v1
MODEL_PATH=./models/market_value_v1.pkl

# Training configuration
TRAINING_DATA_PATH=training_data.csv
MIN_TRAINING_SAMPLES=1000

# Logging
LOG_LEVEL=INFO
