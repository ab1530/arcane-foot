# Database
DATABASE_URL="postgresql://arcane_user:arcane_pass@localhost:5432/arcane_db?schema=public"

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters
JWT_EXPIRES_IN=7d

# Sentry Configuration (Error Tracking & Performance Monitoring)
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=staging
SENTRY_VALIDATE=true
APP_VERSION=1.0.0

# Stripe Configuration (Payment Processing)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Supabase Configuration (File Storage)
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_KEY=service_role_key_here
SUPABASE_STORAGE_BUCKET=arcane-media

# Arkane AI Layer (FastAPI)
AI_SERVICE_URL=http://localhost:8000

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password_or_app_password
EMAIL_FROM=noreply@arcane-football.com

# OpenAI Configuration (for AI features)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic Configuration (alternative AI provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_MODEL=claude-3-5-sonnet-20241022

# ArkaneMatch Configuration (AI-powered scout search)
ARKANE_MATCH_RATE_LIMIT_PER_MINUTE=20
ARKANE_MATCH_RATE_LIMIT_PER_HOUR=100

# Application
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3001

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Data Sync APIs
API_FOOTBALL_KEY=your_api_key_here

# Voice-to-Report Configuration
MAX_AUDIO_SIZE_MB=25
VOICE_REPORT_LANGUAGES=en,es,fr,de,it,pt
AUDIO_STORAGE_BUCKET=voice-reports
