# =================================
# ARCANE FOOTBALL - ENV TEMPLATE
# =================================
#
# Instructions:
# 1. Copier ce fichier: cp .env.template .env
# 2. Demander les vraies valeurs à l'équipe (Slack #dev-team)
# 3. NE JAMAIS commiter le fichier .env!

# =================================
# DATABASE
# =================================
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# =================================
# JWT AUTHENTICATION
# =================================
# Générer avec: openssl rand -hex 32
JWT_SECRET="your-jwt-secret-here-minimum-32-characters"
JWT_REFRESH_SECRET="your-refresh-secret-here-minimum-32-characters"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# =================================
# SUPABASE STORAGE
# =================================
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_KEY="your-service-role-key"

# =================================
# STRIPE PAYMENTS
# =================================
# Use test keys for local dev: sk_test_...
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# =================================
# SENTRY MONITORING
# =================================
SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
SENTRY_ENVIRONMENT="development"

# =================================
# FIREBASE ADMIN
# =================================
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"

# =================================
# AI SERVICE
# =================================
AI_SERVICE_URL="http://localhost:8000"

# =================================
# CORS & SECURITY
# =================================
# Use CORS_ALLOWED_ORIGINS (legacy ALLOWED_ORIGINS is ignored by current bootstrap)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"
FRONTEND_URL="http://localhost:3001"
# Public domain used to build share links like /shortlist/:token
PUBLIC_WEB_URL="http://localhost:3001"
# Optional market link template for public profiles ({query} placeholder supported)
PUBLIC_MARKET_LINK_TEMPLATE="https://www.transfermarkt.com/schnellsuche/ergebnis/schnellsuche?query={query}"
# Internal admin sync key for /api/internal/player-profiles/bulk-upsert
INTERNAL_PROFILE_SYNC_KEY="set-a-long-random-secret"

# =================================
# RATE LIMITING
# =================================
RATE_LIMIT_TTL="60000"
RATE_LIMIT_MAX="100"

# =================================
# API FOOTBALL (External Data Sync)
# =================================
API_FOOTBALL_KEY="your-api-football-key"
API_FOOTBALL_HOST="v3.football.api-sports.io"

# =================================
# EMAIL (Optional - not yet implemented)
# =================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
