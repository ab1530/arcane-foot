generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model achievements {
  id                String              @id
  code              String              @unique
  name              String
  description       String
  icon              String?
  category          AchievementCategory
  rarity            AchievementRarity   @default(COMMON)
  points            Int                 @default(0)
  condition         Json?
  rewardBadge       BadgeType?
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  user_achievements user_achievements[]

  @@index([category])
  @@index([rarity])
}

model audit_logs {
  id         String   @id
  userId     String?
  action     String
  entityType String
  entityId   String?
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType])
  @@index([userId])
}

model contact_messages {
  id        String   @id
  name      String
  email     String
  phone     String?
  type      String
  message   String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamp(6)

  @@index([createdAt])
  @@index([email])
}

model camp_participations {
  id                   String              @id
  campId               String
  playerId             String
  registeredAt         DateTime            @default(now())
  notes                String?
  certificateUrl       String?
  completedAt          DateTime?
  emergencyContact     String?
  emergencyPhone       String?
  evaluatedAt          DateTime?
  feedbackReport       String?
  hasPaid              Boolean             @default(false)
  medicalConditions    String?
  medicalWaiverSigned  Boolean             @default(false)
  medicalWaiverUrl     String?
  mentalRating         Int?
  paidAmount           Float?
  paidAt               DateTime?
  parentEmail          String?
  parentName           String?
  parentPhone          String?
  parentalConsentGiven Boolean             @default(false)
  parentalConsentUrl   String?
  paymentIntentId      String?
  performanceRating    Int?
  physicalRating       Int?
  scoutNotes           String?
  selectedForShowcase  Boolean             @default(false)
  technicalRating      Int?
  status               ParticipationStatus @default(PENDING)
  camps                camps               @relation(fields: [campId], references: [id], onDelete: Cascade)
  players              players             @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([campId, playerId])
  @@index([campId])
  @@index([playerId])
  @@index([status])
}

model camps {
  id                  String                @id
  name                String
  description         String?
  clubId              String?
  location            String
  startDate           DateTime
  endDate             DateTime
  capacity            Int
  ageMin              Int?
  ageMax              Int?
  isPublic            Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  address             String?
  availableSpots      Int
  city                String?
  country             String?
  coverImage          String?
  currency            String                @default("EUR")
  hasShowcaseGame     Boolean               @default(false)
  images              String[]
  includedBenefits    String[]
  partnerClubs        String[]
  price               Float                 @default(0)
  programDetails      String?
  requiredTier        SubscriptionTier?
  requiresPayment     Boolean               @default(false)
  showcaseDate        DateTime?
  status              CampStatus            @default(DRAFT)
  type                CampType              @default(CAMP)
  camp_participations camp_participations[]
  clubs               clubs?                @relation(fields: [clubId], references: [id])

  @@index([clubId])
  @@index([startDate])
  @@index([status])
  @@index([type])
}

model club_requests {
  id          String            @id
  clubId      String
  playerId    String
  status      ClubRequestStatus @default(PENDING)
  requestType String
  message     String?
  offerAmount Float?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime
  respondedAt DateTime?
  clubs       clubs             @relation(fields: [clubId], references: [id])
  players     players           @relation(fields: [playerId], references: [id])

  @@index([clubId])
  @@index([playerId])
  @@index([status])
}

model club_need_requests {
  id                            String                             @id @default(uuid())
  createdById                   String
  requestKind                   TransferRequestKind                @default(LEGACY_RAW)
  rawText                       String
  parsed                        Json
  matchesSnapshot               Json?
  lineStates                    Json?
  clubId                        String?
  clubName                      String?
  country                       String?
  league                        String?
  status                        TransferRequestStatus              @default(OPEN)
  priority                      TaskPriority                       @default(MEDIUM)
  visibility                    TransferRequestVisibility          @default(PRIVATE)
  requirementsJson              Json?
  deadlineAt                    DateTime?
  createdAt                     DateTime                           @default(now())
  updatedAt                     DateTime                           @updatedAt
  club_need_request_activities  club_need_request_activities[]
  club_need_request_suggestions club_need_request_suggestions[]
  clubs                         clubs?                             @relation(fields: [clubId], references: [id], onDelete: SetNull)
  users                         users                              @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([clubId])
  @@index([status])
  @@index([priority])
  @@index([visibility])
  @@index([league])
  @@index([createdAt])
  @@index([requestKind, country, league, status, visibility, createdAt])
}

model club_need_request_suggestions {
  id                 String                 @id @default(uuid())
  requestId          String
  playerId           String
  scoutId            String
  comment            String?
  status             TransferSuggestionStatus @default(PROPOSED)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  club_need_requests club_need_requests     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  players            players                @relation(fields: [playerId], references: [id], onDelete: Cascade)
  users              users                  @relation(fields: [scoutId], references: [id], onDelete: Cascade)

  @@unique([requestId, playerId, scoutId])
  @@index([requestId, createdAt])
  @@index([status])
  @@index([scoutId])
}

model club_need_request_activities {
  id                 String             @id @default(uuid())
  requestId          String
  actorId            String
  actionType         String
  payloadJson        Json?
  createdAt          DateTime           @default(now())
  club_need_requests club_need_requests @relation(fields: [requestId], references: [id], onDelete: Cascade)
  users              users              @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@index([actorId, createdAt])
}

model passport_share_sets {
  id                      String    @id @default(uuid())
  token                   String    @unique
  createdById             String
  title                   String?
  clubName                String?
  sourceFeature           String?
  sourceRequestId         String?
  sourceRequestLineNumber Int?
  items                   Json
  revokedAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  users                   users     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([createdAt])
  @@index([sourceRequestId, sourceRequestLineNumber, createdAt])
}

model clubs {
  id                                String                @id
  name                              String
  shortName                         String?
  logo                              String?
  country                           String
  city                              String?
  stadium                           String?
  founded                           Int?
  website                           String?
  contactUserId                     String?               @unique
  createdAt                         DateTime              @default(now())
  updatedAt                         DateTime
  externalId                        String?               @unique
  externalSource                    String?
  lastSyncAt                        DateTime?
  camps                             camps[]
  club_need_requests                club_need_requests[]
  club_requests                     club_requests[]
  users                             users?                @relation(fields: [contactUserId], references: [id])
  marketplace_offers                marketplace_offers[]
  marketplace_reviews               marketplace_reviews[]
  matches_matches_awayClubIdToclubs matches[]             @relation("matches_awayClubIdToclubs")
  matches_matches_homeClubIdToclubs matches[]             @relation("matches_homeClubIdToclubs")
  players                           players[]
  scout_favorites                   scout_favorites[]
  venues                            venues[]

  @@index([country])
  @@index([externalId])
  @@index([externalSource, externalId])
}

model coaches {
  id                String              @id
  firstName         String
  lastName          String
  email             String              @unique
  phone             String?
  avatar            String?
  bio               String?
  coachingType      CoachingType
  specialties       String[]
  hourlyRate        Float
  currency          String              @default("EUR")
  isActive          Boolean             @default(true)
  availability      Json?
  city              String?
  country           String?
  canWorkRemote     Boolean             @default(false)
  languages         String[]
  certifications    String[]
  yearsExperience   Int?
  minTierRequired   SubscriptionTier    @default(BASIC)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  coaching_bookings coaching_bookings[]

  @@index([city])
  @@index([coachingType])
  @@index([isActive])
}

model coaching_bookings {
  id              String                @id
  userId          String
  coachId         String
  sessionDate     DateTime
  duration        Int                   @default(60)
  location        String?
  isRemote        Boolean               @default(false)
  meetingLink     String?
  status          CoachingBookingStatus @default(PENDING)
  price           Float
  currency        String                @default("EUR")
  hasPaid         Boolean               @default(false)
  paymentIntentId String?
  paidAt          DateTime?
  userNotes       String?
  coachNotes      String?
  userRating      Int?
  userFeedback    String?
  coachFeedback   String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime
  completedAt     DateTime?
  cancelledAt     DateTime?
  coaches         coaches               @relation(fields: [coachId], references: [id])
  users           users                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([coachId])
  @@index([sessionDate])
  @@index([status])
  @@index([userId])
}

model comments {
  id        String   @id
  content   String
  userId    String
  taskId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime
  tasks     tasks?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  users     users    @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([userId])
}

model competitions {
  id             String    @id
  name           String
  shortName      String?
  country        String?
  level          String?
  type           String?
  season         String?
  logo           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  externalId     String?   @unique
  externalSource String?
  matches        matches[]

  @@index([country])
  @@index([externalId])
  @@index([externalSource, externalId])
  @@index([season])
}

model event_assignments {
  id         String   @id
  eventId    String
  userId     String
  assignedAt DateTime @default(now())
  events     events   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  users      users    @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model events {
  id                String              @id
  title             String
  description       String?
  type              EventType           @default(OTHER)
  status            EventStatus         @default(PLANNED)
  startDate         DateTime
  endDate           DateTime
  location          String
  latitude          Float?
  longitude         Float?
  matchId           String?
  createdById       String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  event_assignments event_assignments[]
  users             users               @relation(fields: [createdById], references: [id])
  matches           matches?            @relation(fields: [matchId], references: [id])

  @@index([createdById])
  @@index([startDate])
  @@index([status])
  @@index([type])
}

model kanban_boards {
  id             String           @id
  name           String
  description    String?
  isPublic       Boolean          @default(false)
  ownerId        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  kanban_columns kanban_columns[]

  @@index([ownerId])
}

model kanban_card_activities {
  id           String       @id
  cardId       String
  action       String
  fromColumnId String?
  toColumnId   String?
  description  String?
  metadata     Json?
  createdAt    DateTime     @default(now())
  kanban_cards kanban_cards @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([createdAt])
}

model kanban_cards {
  id                     String                   @id
  columnId               String
  playerId               String
  position               Int                      @default(0)
  notes                  String?
  priority               TaskPriority             @default(MEDIUM)
  tags                   String[]
  dueDate                DateTime?
  reminderDate           DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  movedAt                DateTime                 @default(now())
  kanban_card_activities kanban_card_activities[]
  kanban_columns         kanban_columns           @relation(fields: [columnId], references: [id], onDelete: Cascade)
  players                players                  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([columnId, playerId])
  @@index([columnId])
  @@index([playerId])
  @@index([position])
  @@index([priority])
}

model kanban_columns {
  id            String           @id
  boardId       String
  name          String
  type          KanbanColumnType @default(CUSTOM)
  color         String?
  position      Int              @default(0)
  cardLimit     Int?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime
  kanban_cards  kanban_cards[]
  kanban_boards kanban_boards    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
  @@index([position])
}

model match_assignments {
  id                                          String                @id
  matchId                                     String
  scoutId                                     String
  status                                      MatchAssignmentStatus @default(ASSIGNED)
  missionType                                 MissionType           @default(PRIORITY)
  role                                        MatchAssignmentRole   @default(PRIMARY_SCOUT)
  arrivalTime                                 DateTime?
  seatingSection                              String?
  accessCredentials                           String?
  targetPlayerNames                           String[]
  completedAt                                 DateTime?
  reportSubmitted                             Boolean               @default(false)
  notes                                       String?
  assignedById                                String?
  createdAt                                   DateTime              @default(now())
  updatedAt                                   DateTime
  users_match_assignments_assignedByIdTousers users?                @relation("match_assignments_assignedByIdTousers", fields: [assignedById], references: [id])
  matches                                     matches               @relation(fields: [matchId], references: [id], onDelete: Cascade)
  users_match_assignments_scoutIdTousers      users                 @relation("match_assignments_scoutIdTousers", fields: [scoutId], references: [id], onDelete: Cascade)

  @@unique([matchId, scoutId])
  @@index([matchId])
  @@index([scoutId])
  @@index([status])
}

model matches {
  id                               String                    @id
  homeClubId                       String
  awayClubId                       String
  scheduledAt                      DateTime
  season                           String
  status                           MatchStatus               @default(SCHEDULED)
  homeScore                        Int?
  awayScore                        Int?
  scoutId                          String?
  notes                            String?
  createdAt                        DateTime                  @default(now())
  updatedAt                        DateTime
  attendance                       Int?
  competitionId                    String?
  competitionOld                   String?
  createdById                      String?
  matchDate                        DateTime?
  matchTime                        String?
  referee                          String?
  round                            String?
  timezone                         String                    @default("UTC")
  venueId                          String?
  venueOld                         String?
  auto_generated_reports           auto_generated_reports[]
  events                           events[]
  match_assignments                match_assignments[]
  clubs_matches_awayClubIdToclubs  clubs                     @relation("matches_awayClubIdToclubs", fields: [awayClubId], references: [id])
  competitions                     competitions?             @relation(fields: [competitionId], references: [id])
  users_matches_createdByIdTousers users?                    @relation("matches_createdByIdTousers", fields: [createdById], references: [id])
  clubs_matches_homeClubIdToclubs  clubs                     @relation("matches_homeClubIdToclubs", fields: [homeClubId], references: [id])
  users_matches_scoutIdTousers     users?                    @relation("matches_scoutIdTousers", fields: [scoutId], references: [id])
  venues                           venues?                   @relation(fields: [venueId], references: [id])
  media                            media[]
  performance_predictions          performance_predictions[]
  scouting_reports                 scouting_reports[]

  @@index([competitionId])
  @@index([createdById])
  @@index([matchDate])
  @@index([scheduledAt])
  @@index([scoutId])
  @@index([status])
  @@index([venueId])
}

model media {
  id               String            @id
  type             MediaType
  url              String
  thumbnailUrl     String?
  filename         String
  mimeType         String
  size             Int
  duration         Int?
  width            Int?
  height           Int?
  playerId         String?
  matchId          String?
  reportId         String?
  uploadedAt       DateTime          @default(now())
  processedAt      DateTime?
  matches          matches?          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  players          players?          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  scouting_reports scouting_reports? @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@index([playerId])
  @@index([reportId])
  @@index([type])
}

model notifications {
  id           String    @id
  userId       String
  title        String
  body         String
  type         String
  isRead       Boolean   @default(false)
  readAt       DateTime?
  fcmMessageId String?
  dataJson     Json?
  createdAt    DateTime  @default(now())
  users        users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([isRead])
  @@index([userId])
}

model player_passports {
  id                String         @id
  playerId          String         @unique
  status            PassportStatus @default(PENDING)
  verifiedAt        DateTime?
  verifiedById      String?
  publicToken       String         @unique
  passportData      Json
  expiresAt         DateTime?
  verificationNotes String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime
  players           players        @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([publicToken])
  @@index([status])
}

model players {
  id                              String                            @id
  userId                          String?                           @unique
  clubId                          String?
  position                        String
  preferredFoot                   String?
  jerseyNumber                    Int?
  height                          Float?
  weight                          Float?
  dateOfBirth                     DateTime?
  nationality                     String
  status                          PlayerStatus                      @default(PROSPECT)
  marketValue                     Float?
  contractUntil                   DateTime?
  biography                       String?
  statsJson                       Json?
  createdAt                       DateTime                          @default(now())
  updatedAt                       DateTime
  isPublic                        Boolean                           @default(true)
  parentEmail                     String?
  parentName                      String?
  parentPhone                     String?
  playerType                      PlayerType                        @default(PUBLIC)
  externalId                      String?                           @unique
  externalSource                  String?
  photoUrl                        String?
  verificationStatus              VerificationStatus                @default(PENDING)
  verifiedAt                      DateTime?
  verifiedById                    String?
  lastSyncAt                      DateTime?
  conversionNotes                 String?
  rejectionReason                 String?
  firstName                       String?
  lastName                        String?
  birthYear                       Int?
  observedClubName                String?
  importSource                    String?
  auto_generated_reports          auto_generated_reports[]
  camp_participations             camp_participations[]
  club_need_request_suggestions   club_need_request_suggestions[]
  club_requests                   club_requests[]
  hardware_sessions               HardwareSession[]
  kanban_cards                    kanban_cards[]
  media                           media[]
  performance_predictions         performance_predictions[]
  player_passports                player_passports?
  player_profile_meta             player_profile_meta?
  player_profile_performance_rows player_profile_performance_rows[]
  player_transfer_events          player_transfer_events[]
  player_career_entries           player_career_entries[]
  player_achievements_entries     player_achievements_entries[]
  player_national_team_entries    player_national_team_entries[]
  player_news_entries             player_news_entries[]
  player_rumour_entries           player_rumour_entries[]
  player_valuations               player_valuations[]
  player_views                    player_views[]
  clubs                           clubs?                            @relation(fields: [clubId], references: [id])
  users                           users?                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  prediction_accuracy_log         prediction_accuracy_log[]
  scouting_reports                scouting_reports[]

  @@index([clubId])
  @@index([externalId])
  @@index([externalSource, externalId])
  @@index([playerType])
  @@index([position])
  @@index([status])
  @@index([verificationStatus])
  @@index([birthYear])
  @@index([firstName, lastName])
  @@index([observedClubName])
}

model HardwareSession {
  id                    String   @id @default(uuid())
  playerId              String
  deviceId              String
  source                String
  type                  String
  startedAt             DateTime
  endedAt               DateTime
  movementDistanceM     Float?
  sprintDistanceM       Float?
  offenseDefenseRatio   Float?
  avgSpeedKmh           Float?
  maxSpeedKmh           Float?
  sprintTimeS           Float?
  sprintCount           Int?
  totalTimeMin          Float?
  caloriesBurned        Float?
  maxAccelerationG      Float?
  maxDecelerationG      Float?
  accelerationCount     Int?
  reductionStepsCount   Int?
  thermalTrajectoryMap  Json?
  sprintVectorData      Json?
  motionTrajectoryData  Json?
  qualitySixDimensional Json?
  rawMetrics            Json?
  normalizedMetrics     Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  players               players  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([startedAt])
  @@map("hardware_sessions")
}

model player_views {
  id       String   @id @default(uuid())
  viewerId String
  playerId String
  viewedAt DateTime @default(now())
  source   String?
  players  players  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  viewer   users    @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([viewerId, playerId])
  @@index([viewerId])
  @@index([playerId])
  @@index([viewedAt])
  @@map("player_views")
}

model scouting_notes {
  id               String           @id
  reportId         String
  minute           Int?
  category         String
  content          String
  rating           Int?
  createdAt        DateTime         @default(now())
  scouting_reports scouting_reports @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model scouting_reports {
  id                       String              @id
  matchId                  String
  playerId                 String
  scoutId                  String
  status                   ReportStatus        @default(DRAFT)
  overallRating            Int?
  summary                  String?
  strengths                String?
  weaknesses               String?
  notesJson                Json?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime
  submittedAt              DateTime?
  reviewedAt               DateTime?
  mentalRating             Int?
  physicalRating           Int?
  playerMinutesPlayed      Int?
  playerPosition           String?
  recommendation           RecommendationType?
  recommendationNotes      String?
  reviewedBy               String?
  similarPlayerIds         String[]
  tacticalRating           Int?
  tags                     String[]
  technicalRating          Int?
  withBallAnalysis         String?
  offBallAnalysis          String?
  gameIntelligenceAnalysis String?
  attitudeAnalysis         String?
  staffOpinion             String?
  observedDominantFoot     String?
  observedHeightCm         Int?
  observedWeightKg         Int?
  observedClubName         String?
  observedFirstName        String?
  observedLastName         String?
  observedNationality      String?
  observedPhone            String?
  observedEmail            String?
  sprint10mSec             Float?
  sprint20mSec             Float?
  sprint40mSec             Float?
  vmaKmh                   Float?
  media                    media[]
  report_embeddings        report_embeddings?
  scouting_notes           scouting_notes[]
  matches                  matches             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  players                  players             @relation(fields: [playerId], references: [id], onDelete: Cascade)
  users                    users               @relation(fields: [scoutId], references: [id])

  @@index([matchId])
  @@index([playerId])
  @@index([recommendation])
  @@index([scoutId])
  @@index([status])
}

model subscriptions {
  id                   String             @id
  userId               String             @unique
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(TRIAL)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  startDate            DateTime           @default(now())
  endDate              DateTime?
  trialEndsAt          DateTime?
  cancelAt             DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime
  users                users              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([tier])
}

model tasks {
  id                            String       @id
  title                         String
