# =============================================
# ARCANE QA AUTONOMY SYSTEM - CONFIGURATION
# =============================================

# ----------------
# MODE D'EXÉCUTION
# ----------------
# local = Exécution manuelle locale
# ci = Exécution dans pipeline GitLab
# watch = Surveillance continue des changements
QA_MODE=local

# ----------------
# COMPORTEMENT
# ----------------
# Auto-commit des corrections appliquées
QA_AUTO_COMMIT=true

# Arrêter l'exécution si erreur critique
STOP_ON_CRITICAL_ERROR=true

# Nombre d'agents exécutés en parallèle (max 5)
QA_PARALLELISM=3

# ----------------
# NOTIFICATIONS
# ----------------
# Slack webhook pour notifications critiques
SLACK_WEBHOOK_URL=

# Email pour notifications (optionnel)
QA_NOTIFICATION_EMAIL=

# Activer notifications Sentry
SENTRY_QA_ENABLED=false
SENTRY_DSN=

# ----------------
# SEUILS DE QUALITÉ
# ----------------
# Couverture de tests minimale (%)
MIN_TEST_COVERAGE=70

# Couverture de tests cible (%)
TARGET_TEST_COVERAGE=85

# Temps de build maximum (ms)
MAX_BUILD_TIME=300000

# Taux d'erreurs acceptable (%)
MAX_ERROR_RATE=5

# Taux de correction auto minimal (%)
MIN_AUTO_FIX_RATE=50

# ----------------
# TIMEOUTS (ms)
# ----------------
# Timeout QA-Agent (tests globaux)
QA_AGENT_TIMEOUT=300000

# Timeout Fix-Agent (corrections)
FIX_AGENT_TIMEOUT=180000

# Timeout API-Agent
API_AGENT_TIMEOUT=120000

# Timeout Web-Agent
WEB_AGENT_TIMEOUT=180000

# Timeout Mobile-Agent (Expo peut être lent)
MOBILE_AGENT_TIMEOUT=240000

# Timeout AI-Agent
AI_AGENT_TIMEOUT=120000

# Timeout DevOps-Agent (builds Docker)
DEVOPS_AGENT_TIMEOUT=300000

# ----------------
# CHEMINS
# ----------------
# Chemin du rapport principal
QA_REPORT_PATH=qa-agents/reports/QA_AUTONOMY_REPORT.md

# Chemin des logs
QA_LOGS_PATH=qa-agents/logs

# Chemin historique rapports
QA_HISTORY_PATH=qa-agents/reports/history

# ----------------
# AGENTS ACTIVATION
# ----------------
# Activer/désactiver agents individuellement
QA_AGENT_ENABLED=true
FIX_AGENT_ENABLED=true
API_AGENT_ENABLED=true
WEB_AGENT_ENABLED=true
MOBILE_AGENT_ENABLED=true
AI_AGENT_ENABLED=true
DEVOPS_AGENT_ENABLED=true
REPORTER_AGENT_ENABLED=true

# ----------------
# TESTS
# ----------------
# Skip tests E2E (longs)
QA_SKIP_E2E=false

# Skip tests mobile
QA_SKIP_MOBILE=false

# Skip tests AI
QA_SKIP_AI=false

# ----------------
# CORRECTIONS AUTO
# ----------------
# Appliquer corrections TypeScript
AUTO_FIX_TYPESCRIPT=true

# Appliquer corrections imports
AUTO_FIX_IMPORTS=true

# Installer dépendances manquantes
AUTO_INSTALL_DEPS=true

# Formater code après corrections
AUTO_FORMAT_CODE=true

# Créer stubs pour routes 404
AUTO_CREATE_STUBS=true

# ----------------
# GIT
# ----------------
# Branch pour auto-commit (laisser vide = current)
GIT_AUTO_COMMIT_BRANCH=

# Prefix des commits auto
GIT_COMMIT_PREFIX=chore(qa)

# ----------------
# ADVANCED
# ----------------
# Mode verbose (logs détaillés)
QA_VERBOSE=false

# Mode debug (très verbeux)
QA_DEBUG=false

# Dry run (simulation sans modifications)
QA_DRY_RUN=false

# Générer rapport JSON en plus du Markdown
QA_JSON_REPORT=false

# ----------------
# CRON (CI/CD)
# ----------------
# Expression cron pour exécution automatique
# Default: Tous les jours à 3h du matin
QA_CRON_SCHEDULE=0 3 * * *

# ----------------
# INTÉGRATIONS
# ----------------
# GitHub Actions
GITHUB_TOKEN=

# GitLab CI
GITLAB_TOKEN=

# Jira (pour créer tickets sur erreurs critiques)
JIRA_URL=
JIRA_USER=
JIRA_TOKEN=

# =============================================
# FIN DE LA CONFIGURATION
# =============================================
